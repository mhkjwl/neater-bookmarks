{
	"name": "__MSG_extName__",
	"version": "0.9.8.5",
	"manifest_version": 3,
	"description": "__MSG_extDesc__",
	"icons": {
		"16": "icon16.png",
		"48": "icon48.png",
		"128": "icon128.png"
	},
	"action": {
		"default_icon": "icon.png",
		"default_popup": "popup.html"
	},
	"options_page": "options.html",
