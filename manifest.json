		"service_worker": "background.js"
	},
	"permissions": [
		"bookmarks",
		"favicon",
		"tabs",
		"storage"
	],
	"minimum_chrome_version": "150",
	"default_locale": "en",
	"omnibox": {
		"keyword" : "*"
	}
}
